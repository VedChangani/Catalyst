# Catalyst frontend configuration - EXAMPLE ONLY.
#
# Copy to client/.env.local and fill in. Every VITE_ variable is compiled into the browser bundle
# and is PUBLIC: never put a secret here (the Razorpay key SECRET belongs only in the backend .env).

# Backend API base URL (including the /api/v1.0 context path).
# `npm run dev` falls back to http://localhost:8080/api/v1.0 when unset;
# `npm run build` (production) fails unless it is set.
VITE_API_BASE_URL=http://localhost:8080/api/v1.0

# Razorpay public key id for the checkout widget (the same value as the backend RAZORPAY_KEY_ID).
VITE_RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID_HERE
