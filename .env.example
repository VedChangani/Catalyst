# Catalyst backend configuration - EXAMPLE ONLY.
#
# Copy to `.env` in this repository root (C:\Catalyst\.env) and fill in real values locally.
# The backend is run with the repository root as its working directory and imports this file
# (spring.config.import=optional:file:.env[.properties]). The real .env is sensitive and is
# git-ignored: never commit it. The frontend has its own file: client/.env.example.

# ---- Database (MySQL) ----
# Optional: defaults to jdbc:mysql://localhost:3306/billing_app when unset.
DB_URL=jdbc:mysql://localhost:3306/billing_app
DB_USERNAME=
DB_PASSWORD=YOUR_DB_PASSWORD_HERE

# ---- JWT signing secret (long, random) ----
JWT_SECRET_KEY=YOUR_JWT_SECRET_HERE

# ---- Razorpay (the key id is also given to the frontend; the secret NEVER is) ----
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET_HERE

# ---- AWS / S3 ----
AWS_ACCESS_KEY=YOUR_AWS_ACCESS_KEY_HERE
AWS_SECRET_KEY=YOUR_AWS_SECRET_KEY_HERE
AWS_REGION=eu-north-1
AWS_BUCKET_NAME=YOUR_BUCKET_NAME_HERE

# ---- Frontend origin(s) allowed by CORS ----
# Comma-separated explicit origins; "*" is rejected at startup. Default: http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Directory uploaded images are written to / served from ----
# Relative to the working directory. Default: uploads
APP_UPLOADS_DIR=uploads

# ---- Public URL of uploaded images (this API's /uploads/** route) ----
# Default: http://localhost:8080/api/v1.0/uploads
APP_UPLOADS_PUBLIC_BASE_URL=http://localhost:8080/api/v1.0/uploads

# ---- Customer forgot-password (emailed one-time code) ----
# REQUIRED: the backend refuses to start without it. A random secret of at least 32 characters used
# as the HMAC key for stored code hashes. Must NOT be the same as JWT_SECRET_KEY.
# Generate one, e.g.:  openssl rand -base64 48
APP_PASSWORD_RESET_OTP_SECRET=YOUR_RANDOM_OTP_SECRET_OF_32_OR_MORE_CHARS_HERE
# SMTP (any provider). Leave MAIL_HOST empty in local development to send no mail at all - or run a
# local capture server (Mailpit: `docker run -p 1025:1025 -p 8025:8025 axllent/mailpit`, then set
# MAIL_HOST=localhost, MAIL_PORT=1025, MAIL_SMTP_AUTH=false, MAIL_SMTP_STARTTLS=false and read the
# mail at http://localhost:8025; MailHog works the same way). Not needed by tests.
# PRODUCTION (Spring profile "prod"): MAIL_HOST and APP_MAIL_FROM are REQUIRED, or startup fails.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=YOUR_SMTP_PASSWORD_HERE
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
# From address of the reset email
APP_MAIL_FROM=Catalyst <no-reply@your-domain.example>
# Set true ONLY when the backend sits behind a reverse proxy (like the bundled nginx) that appends the
# real client address to X-Forwarded-For; it is used for per-IP rate limiting. Default false.
APP_TRUST_FORWARDED_FOR=false

# ---- Initial ADMIN bootstrap (optional) ----
# Only when enabled AND no admin exists yet is exactly one admin created. It never modifies an
# existing account. With bootstrap enabled every value below is required (startup fails otherwise);
# the password must be 8-72 characters with a letter and a number. Consider disabling it again
# once the admin exists.
APP_ADMIN_BOOTSTRAP_ENABLED=true
APP_ADMIN_NAME=
APP_ADMIN_EMAIL=
APP_ADMIN_MOBILE=
APP_ADMIN_PASSWORD=

# ---- Docker (`docker compose up --build`) ----
# Separate Docker MySQL (named volume); independent of your local MySQL and of DB_* above.
# Compose sets DB_URL/CORS/uploads for the backend itself. JWT/Razorpay/AWS/admin values above are reused.
DOCKER_MYSQL_ROOT_PASSWORD=YOUR_DOCKER_MYSQL_ROOT_PASSWORD_HERE
DOCKER_MYSQL_USER=catalyst
DOCKER_MYSQL_PASSWORD=YOUR_DOCKER_MYSQL_PASSWORD_HERE
# Host port for the app (http://localhost:8081 by default)
FRONTEND_PORT=8081
